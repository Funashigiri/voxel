}

// Кириллические буквы, совпадающие по начертанию с латинскими (и З = 3).
@(private = "file")
GLYPH_ALIASES := [?][2]rune {
	{'А', 'A'}, {'В', 'B'}, {'Е', 'E'}, {'К', 'K'}, {'М', 'M'}, {'Н', 'H'}, {'О', 'O'},
	{'Р', 'P'}, {'С', 'C'}, {'Т', 'T'}, {'Х', 'X'}, {'З', '3'},
	{'а', 'a'}, {'е', 'e'}, {'о', 'o'}, {'р', 'p'}, {'с', 'c'}, {'у', 'y'}, {'х', 'x'},
	{'×', 'x'}, {'·', '.'}, {'—', '-'}, {'–', '-'},
}
// odinfmt: enable

text_init :: proc() {
	glyphs = make(map[rune]Glyph, 256)
	for src in GLYPH_SRC {
		g: Glyph
		g.width = u8(len(src.rows[0]))
		for row, i in src.rows {
			bits: u8
			for c, j in transmute([]u8)row {
				if c == '#' do bits |= 1 << u8(j)
			}
			g.rows[i] = bits
		}
		glyphs[src.r] = g
	}
	for a in GLYPH_ALIASES {
		if g, ok := glyphs[a[1]]; ok do glyphs[a[0]] = g
	}
}

@(private = "file")
glyph_of :: proc(r: rune) -> Glyph {
	if g, ok := glyphs[r]; ok do return g
	return glyphs['?']
}

// Ширина строки в пикселях экрана (px — размер пикселя шрифта).
text_width :: proc(s: string, px: f32) -> f32 {
	w: f32
	for r in s do w += f32(glyph_of(r).width + 1)
	return max(w - 1, 0) * px
}

@(private = "file")
draw_glyphs :: proc(s: string, x, y, px: f32, color: [4]u8) {
	cx := x
	for r in s {
		g := glyph_of(r)
		for row, j in g.rows {
			if row == 0 do continue
			// склеиваем соседние пиксели строки в один прямоугольник
			i := u8(0)
			for i < g.width {
				if row & (1 << i) == 0 {
					i += 1
					continue
				}
				start := i
				for i < g.width && row & (1 << i) != 0 do i += 1
				y0 := y + f32(j) * px
				imm_rect(cx + f32(start) * px, y0, cx + f32(i) * px, y0 + px, color)
			}
		}
		cx += f32(g.width + 1) * px
	}
}

// Текст с тенью, как в Minecraft. (x, y) — левый верхний угол.
draw_text :: proc(s: string, x, y, px: f32, color: [4]u8, shadow := true) {
	if shadow {
		sc := [4]u8{color.r / 4, color.g / 4, color.b / 4, color.a}
		draw_glyphs(s, x + px, y + px, px, sc)
	}
	draw_glyphs(s, x, y, px, color)
}

// Делает первую букву заглавной (латиница и кириллица).
capitalize :: proc(s: string, allocator := context.temp_allocator) -> string {
	if len(s) == 0 do return s
	b := strings.builder_make(allocator)
	first := true
	for r in s {
		c := r
		if first {
			switch r {
			case 'a' ..= 'z', 'а' ..= 'я':
				c = r - 32
			case 'ё':
				c = 'Ё'
			}
			first = false
		}
		strings.write_rune(&b, c)
	}
	return strings.to_string(b)
}
