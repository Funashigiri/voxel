package engine

// Пиксельный шрифт 5x7 (латиница, кириллица, цифры, знаки) в духе Minecraft.
// Глифы нарисованы прямо в коде: '#' — пиксель, '.' — пусто. Строки 0..6 —
// над базовой линией, строка 7 — "хвосты" (у, р, д, щ...).
// Текст рисуется через immediate-рендер: каждый отрезок пикселей — прямоугольник.

import "core:strings"

GLYPH_ROWS :: 8
TEXT_LINE_HEIGHT :: 10 // в пикселях шрифта

@(private = "file")
Glyph :: struct {
	width: u8,
	rows:  [GLYPH_ROWS]u8, // биты слева направо
}

@(private = "file")
Glyph_Src :: struct {
	r:    rune,
	rows: [GLYPH_ROWS]string,
}

@(private = "file")
glyphs: map[rune]Glyph

// odinfmt: disable
@(private = "file")
GLYPH_SRC := [?]Glyph_Src {
	{' ', {"...", "...", "...", "...", "...", "...", "...", "..."}},
	{'A', {".###.", "#...#", "#...#", "#####", "#...#", "#...#", "#...#", ""}},
	{'B', {"####.", "#...#", "#...#", "####.", "#...#", "#...#", "####.", ""}},
	{'C', {".###.", "#...#", "#....", "#....", "#....", "#...#", ".###.", ""}},
	{'D', {"####.", "#...#", "#...#", "#...#", "#...#", "#...#", "####.", ""}},
	{'E', {"#####", "#....", "#....", "####.", "#....", "#....", "#####", ""}},
	{'F', {"#####", "#....", "#....", "####.", "#....", "#....", "#....", ""}},
	{'G', {".###.", "#...#", "#....", "#.###", "#...#", "#...#", ".###.", ""}},
	{'H', {"#...#", "#...#", "#...#", "#####", "#...#", "#...#", "#...#", ""}},
	{'I', {"###", ".#.", ".#.", ".#.", ".#.", ".#.", "###", ""}},
